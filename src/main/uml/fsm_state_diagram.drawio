          <mxGeometry height="430" width="900" x="130" y="-60" as="geometry">
            <mxRectangle height="50" width="90" x="170" y="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="stFxkW6RNNFT0NWJiz85-11" parent="stFxkW6RNNFT0NWJiz85-10" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;u&gt;Triggers&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(108, 142, 191);&quot;&gt;CARD_DETECTION_START_REQUESTED&lt;/font&gt;&lt;/b&gt; — application called &lt;i&gt;startCardDetection()&lt;/i&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(108, 142, 191);&quot;&gt;CARD_DETECTION_STOP_REQUESTED&lt;/font&gt; &lt;/b&gt;— application called &lt;i&gt;stopCardDetection()&lt;/i&gt; — factorized on the composite state boundary&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(108, 142, 191);&quot;&gt;CARD_PROCESSING_ENDED&lt;/font&gt;&amp;nbsp;&lt;/b&gt;— application called&amp;nbsp;&lt;i&gt;finalizeCardProcessing()&lt;/i&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;CARD_INSERTED&lt;/font&gt; &lt;/b&gt;— monitoring job detected a card&lt;/li&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;CARD_REMOVED&lt;/font&gt; &lt;/b&gt;— monitoring job detected card removal&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;text-decoration-line: underline;&quot;&gt;Reader Capabilities&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;[MONITORING_DURING_PROCESSING]&lt;/b&gt; — reader can detect card removal while processing is running &lt;b&gt;&amp;amp;&amp;amp;&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;card processing is executed in a dedicated thread&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;u&gt;Card States&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;[CARD_PROCESSABLE]&lt;/b&gt; — inserted card matches current selection policy&amp;nbsp;&lt;b&gt;||&lt;/b&gt; CardPresenceNotificationPolicy == ALWAYS&lt;/li&gt;&lt;li&gt;&lt;b&gt;[CARD_NON_PROCESSABLE]&lt;/b&gt; — inserted card does not match current selection policy&amp;nbsp;&lt;b&gt;&amp;amp;&amp;amp;&lt;/b&gt; CardPresenceNotificationPolicy == MATCHED_ONLY&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;Guards&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;[REPEATING]&lt;/b&gt; — DetectionMode == REPEATING&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;[SINGLE_SHOT]&lt;/b&gt; — DetectionMode == SINGLE_SHOT&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;Actions&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;/ spi.method()&lt;/b&gt; — call on ObservableReaderSpi (hardware notification)&lt;/li&gt;&lt;li&gt;&lt;b&gt;/ reader.method()&lt;/b&gt; — call on ObservableLocalReaderAdapter (event production / observer notification)&lt;/li&gt;&lt;li&gt;&lt;b&gt;/ start job&lt;/b&gt; — monitoring job submitted to background executor&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="900" y="50" as="geometry" />
        </mxCell>
